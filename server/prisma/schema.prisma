generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]
  seedFixtures SeedFixture[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]
  seedFixtures SeedFixture[]

  @@index([isActive, name])
}

model User {
  id                    Int                   @id @default(autoincrement())
  name                  String                @db.VarChar(120)
  email                 String                @unique @db.VarChar(254)
  role                  UserRole              @default(REQUESTER)
  passwordHash          String                @db.VarChar(255)
  mustChangePassword    Boolean               @default(true)
  isActive              Boolean               @default(true)
  passwordChangedAt     DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  requestedTickets      Ticket[]              @relation("TicketRequester")
  ownedTickets          Ticket[]              @relation("TicketOwner")
  resolutionIndications Ticket[]              @relation("TicketResolutionIndicatedBy")
  uploadedAttachments   Attachment[]          @relation("AttachmentUploader")
  removedAttachments    Attachment[]          @relation("AttachmentRemover")
  sessions              AuthSession[]
  publicComments        PublicComment[]
  internalNotes         InternalNote[]
  ticketStatusHistory   TicketStatusHistory[]
  createdActions        Action[]              @relation("ActionCreator")
  assignedActions       Action[]              @relation("ActionAssignee")
  performedActions      Action[]              @relation("ActionPerformer")
  actionHistory         ActionHistory[]
  mutationReceipts       MutationReceipt[]
  seedFixtures          SeedFixture[]

  @@index([role, isActive, name])
}

model AuthSession {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique @db.Char(64)
  csrfTokenHash String   @db.Char(64)
  userId        Int
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  expiresAt     DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  keyHash         String    @id @db.Char(64)
  failureCount    Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt
}

model TicketNumberSequence {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model Ticket {
  id                               Int                   @id @default(autoincrement())
  ticketNumber                     String                @unique @db.VarChar(20)
  ticketDate                       DateTime              @default(now())
  clientSubmissionId               String                @db.Uuid
  requesterId                      Int
  categoryId                       Int
  relatedSystemId                  Int
  summary                          String                @db.VarChar(150)
  requestedPriority                RequestedPriority
  description                      String                @db.Text
  currentStatus                    TicketStatus          @default(NEW)
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @default(now()) @updatedAt
  ownerId                          Int?
  itPriority                       RequestedPriority
  requesterResolutionIndicatedAt   DateTime?
  requesterResolutionIndicatedById Int?
  requester                        User                  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner                            User?                 @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requesterResolutionIndicatedBy   User?                 @relation("TicketResolutionIndicatedBy", fields: [requesterResolutionIndicatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category                         Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedSystem                    RelatedSystem         @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attachments                      Attachment[]
  publicComments                   PublicComment[]
  internalNotes                    InternalNote[]
  statusHistory                    TicketStatusHistory[]
  actions                          Action[]
  mutationReceipts                  MutationReceipt[]
  seedFixtures                     SeedFixture[]

  @@unique([requesterId, clientSubmissionId])
  @@index([requesterId, updatedAt])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([requestedPriority])
  @@index([currentStatus])
  @@index([updatedAt, id])
  @@index([ownerId, updatedAt])
  @@index([currentStatus, updatedAt])
  @@index([itPriority, updatedAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String    @db.VarChar(255)
  storageKey       String    @unique @db.VarChar(255)
  mimeType         String    @db.VarChar(100)
  sizeBytes        Int
  uploadedByUserId Int
  isRemoved        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  removedAt        DateTime?
  removedByUserId  Int?
  removalReason    String?   @db.VarChar(200)
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedByUser   User      @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  removedByUser    User?     @relation("AttachmentRemover", fields: [removedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, isRemoved])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, createdAt, id])
}

model TicketStatusHistory {
  id         Int          @id @default(autoincrement())
  ticketId   Int
  actorId    Int
  fromStatus TicketStatus
  toStatus   TicketStatus
  reason     String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actionCancellationHistory ActionHistory[] @relation("ActionCancellationSource")

  @@index([ticketId, createdAt, id])
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionHistoryEvent {
  ACTION_CREATED
  ACTION_EDITED
  ACTION_REASSIGNED
  ACTION_STARTED
  ACTION_COMPLETED
  ACTION_CANCELLED
  ACTION_CANCELLED_BY_TICKET
}

// Row CHECK constraints live in the additive SQL migration. Eligibility and
// immutable attribution/strictly increasing update times are service rules.
model Action {
  id                 Int          @id @default(autoincrement())
  ticketId           Int
  createdById        Int
  assigneeId         Int
  performedById      Int?
  description        String       @db.Text
  result             String?      @db.Text
  status             ActionStatus @default(PLANNED)
  followUpRequired   Boolean      @default(false)
  followUpNote       String?      @db.Text
  attachmentNotes    String?      @db.Text
  actionAt           DateTime     @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  createdAt          DateTime     @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  updatedAt          DateTime     @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  completedAt        DateTime?    @db.Timestamp(3)
  cancelledAt        DateTime?    @db.Timestamp(3)
  cancellationReason String?      @db.VarChar(500)
  version            Int          @default(1)
  ticket             Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User         @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignee           User         @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  performedBy        User?        @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  history            ActionHistory[]
  mutationReceipts   MutationReceipt[]
  seedFixtures       SeedFixture[]

  @@index([ticketId, createdAt, id])
  @@index([ticketId, status])
  @@index([assigneeId, status, createdAt, id])
}

// Snapshot projection and source-event same-Ticket validation remain service
// obligations; SQL enforces object/null, event/version and source-presence rules.
model ActionHistory {
  id                          Int                @id @default(autoincrement())
  actionId                    Int
  actorId                     Int
  event                       ActionHistoryEvent
  createdAt                   DateTime           @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  actionVersion               Int
  before                      Json?              @db.JsonB
  after                       Json               @db.JsonB
  sourceTicketStatusHistoryId Int?
  action                      Action             @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor                       User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceTicketStatusHistory   TicketStatusHistory? @relation("ActionCancellationSource", fields: [sourceTicketStatusHistoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actionId, createdAt, id])
  @@unique([actionId, actionVersion])
}

// Only the canonical original-input digest and projected safe response belong
// here. Services must never persist credentials, sessions or raw private input.
model MutationReceipt {
  id               Int      @id @default(autoincrement())
  actorId          Int
  clientMutationId String   @db.Uuid
  operation        String   @db.Text
  ticketId         Int
  actionId         Int
  inputFingerprint String   @db.Char(64)
  safeResponse     Json     @db.JsonB
  createdAt        DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  actor            User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action           Action   @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([actorId, clientMutationId])
}

// SQL requires exactly one typed target. Registry population/reseeding is a
// later change; the migration creates no domain or registry fixtures.
model SeedFixture {
  id              Int            @id @default(autoincrement())
  fixtureKey      String         @unique @db.Text
  userId          Int?
  categoryId      Int?
  relatedSystemId Int?
  ticketId        Int?
  actionId        Int?
  createdAt       DateTime       @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  user            User?          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedSystem   RelatedSystem? @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticket          Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action          Action?        @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}
