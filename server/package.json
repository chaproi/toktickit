{
  "name": "toktickit-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:lab3": "tsx src/migration/run-lab3-migration.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
